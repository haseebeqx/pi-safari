{
  "name": "@haseebeqx/pi-safari",
  "version": "0.5.1",
  "license": "MIT",
  "description": "Safari automation tools for Pi using Apple's built-in local MCP server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haseebeqx/pi-safari.git"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "browser",
    "web-search",
    "browser-use",
    "fetch",
    "browser-automation"
  ],
  "files": [
    "src",
    "!src/index-unrestricted.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "typebox": "1.3.27"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:live": "node --experimental-strip-types scripts/live-smoke.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run typecheck",
    "stage:unrestricted": "node --experimental-strip-types scripts/stage-unrestricted.ts",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
